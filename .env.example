# Copy to .env.local (dev) or pass as a Docker build arg (prod).

# Base URL of the MatchPoint Django API.
# Leave empty to use the same origin — the Docker image's nginx proxies /api/ to the backend.
VITE_API_URL=http://localhost:8000

# 1 = serve demo fixtures instead of the API — no backend needed. Set for `npm run dev` or as a
# Docker build arg to produce a demo image (`VITE_DEMO=1 docker compose up --build web`). It is a
# build-time decision: an image built without it can never be switched to fixtures at runtime.
VITE_DEMO=0
