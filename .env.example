# Copy to .env.local (dev) or pass as a Docker build arg (prod).

# Base URL of the MatchPoint Django API.
# Leave empty to use the same origin — the Docker image's nginx proxies /api/ to the backend.
VITE_API_URL=http://localhost:8000

# 1 = serve demo fixtures instead of the API — no backend needed. Set for `npm run dev` or as a
# Docker build arg to produce a demo image (`VITE_DEMO=1 docker compose up --build web`). It is a
# build-time decision: an image built without it can never be switched to fixtures at runtime.
VITE_DEMO=0

# --- Running the backend from this repo (docker-compose.api.yml) --------------
# Where the MatchPoint API checkout lives, relative to this directory.
API_PATH=../matchpoint-api
# Published port for the API. The built image reaches it through nginx instead.
API_PORT=8000
# 0 skips scripts/seed_api.py, leaving an empty database.
SEED=1
# Django settings for the local stack. Never ship these values.
SECRET_KEY=dev-only-not-a-real-secret
ALLOWED_HOSTS=*
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=example
